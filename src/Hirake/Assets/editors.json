      "knownPaths": ["%ProgramFiles%\\Sublime Text\\sublime_text.exe"],
      "fileArgs": ["{file}:{line}"],
      "noLineArgs": ["{file}"],
      "folderArgs": ["{folder}"],
      "supportsLine": true,
      "verified": null
    },
    {
      "id": "gvim",
      "name": "gVim",
      "exeNames": ["gvim.exe"],
      "knownPaths": ["%ProgramFiles%\\Vim\\vim91\\gvim.exe"],
      "fileArgs": ["+{line}", "{file}"],
