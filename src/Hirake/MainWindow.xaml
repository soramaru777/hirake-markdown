<Window x:Class="Hirake.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hirake"
        Title="Hirake"
        Height="800" Width="1100"
        AllowDrop="True"
        Background="{DynamicResource ChromeWindowBackground}"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- WPF クロームのテーマ配色。既定はライト。コードから this.Resources[key] を差し替えてダークへ切替える。 -->
    <Window.Resources>
        <SolidColorBrush x:Key="ChromeWindowBackground" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ChromeBarBackground" Color="#FFF3F3F3" />
        <SolidColorBrush x:Key="ChromeBorder" Color="#FFDDDDDD" />
        <SolidColorBrush x:Key="ChromeText" Color="#FF1F1F1F" />
        <SolidColorBrush x:Key="ChromeTitleText" Color="#FF888888" />
        <SolidColorBrush x:Key="ChromeSubText" Color="#FFAAAAAA" />
        <!-- サイドバー用の追加配色（ApplyChromeTheme でライト/ダーク両方を差し替える）。 -->
        <SolidColorBrush x:Key="ChromeAccent" Color="#FF0969DA" />
        <SolidColorBrush x:Key="ChromeHover" Color="#FFE8E8E8" />
        <SolidColorBrush x:Key="ChromeInputBackground" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ChromeActiveBackground" Color="#FFDDEBFF" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- タブヘッダー（横スクロール可・単一行）＋左端トグル＋右端のツールボタン群 -->
        <Border Grid.Row="0"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource ChromeBorder}"
                Background="{DynamicResource ChromeBarBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- ファイルツリー サイドバーのトグル -->
                <Button x:Name="SidebarToggleButton"
                        Grid.Column="0"
                        Click="SidebarToggleButton_Click"
                        Content="&#xE700;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Padding="8,4"
                        Margin="6,2,2,2"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="{DynamicResource ChromeText}"
                        Cursor="Hand"
                        ToolTip="ファイルツリー (Ctrl+B)" />

                <ListBox x:Name="TabList"
                 Grid.Column="1"
                 ItemsSource="{Binding Tabs}"
                 SelectionChanged="TabList_SelectionChanged"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 KeyboardNavigation.DirectionalNavigation="Contained">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <EventSetter Event="MouseUp" Handler="TabItem_MouseUp" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="1,2,1,0" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal"
                                Margin="8,4,4,4"
                                ToolTip="{Binding FilePath}">
                        <StackPanel.ContextMenu>
                            <ContextMenu Opened="TabContextMenu_Opened">
                                <MenuItem Header="この位置へのリンクをコピー"
                                          Click="CopyDeepLink_Click"
                                          Tag="{Binding}"
                                          IsEnabled="{Binding SupportsDeepLink}" />
                                <Separator />
                                <MenuItem Header="エディタで開く (Ctrl+E)"
                                          Click="OpenInEditor_Click"
                                          Tag="{Binding}"
                                          IsEnabled="{Binding SupportsDeepLink}" />
                                <MenuItem Header="フォルダをエディタで開く"
                                          Click="OpenFolderInEditor_Click"
                                          Tag="{Binding}"
                                          CommandParameter="openFolder"
                                          IsEnabled="{Binding SupportsDeepLink}" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <TextBlock Text="{Binding FileName}"
                                   VerticalAlignment="Center"
                                   MaxWidth="240"
                                   Foreground="{DynamicResource ChromeText}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Content="&#x2715;"
                                Click="CloseTab_Click"
                                Tag="{Binding}"
                                Margin="6,0,0,0"
                                Padding="4,0"
                                FontSize="10"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="{DynamicResource ChromeText}"
                                Cursor="Hand"
                                ToolTip="タブを閉じる" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="GraphButton"
                            Click="GraphButton_Click"
                            Content="&#xE9D2;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Padding="8,4"
                            Margin="4,2,0,2"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource ChromeText}"
                            Cursor="Hand"
                            ToolTip="ナレッジグラフ = キャンバスの全体俯瞰 (Ctrl+G)" />

                    <Button x:Name="CanvasButton"
                            Click="CanvasButton_Click"
                            Content="&#xE81E;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Padding="8,4"
                            Margin="4,2,0,2"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource ChromeText}"
                            Cursor="Hand"
                            ToolTip="無限キャンバス (Ctrl+Shift+C)" />

                    <Button x:Name="StructureButton"
                            Click="StructureButton_Click"
                            Content="&#xE8FD;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Padding="8,4"
                            Margin="4,2,0,2"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource ChromeText}"
                            Cursor="Hand"
                            ToolTip="構造クエリ (Ctrl+Shift+S)" />

                    <Button x:Name="FingerprintButton"
                            Click="FingerprintButton_Click"
                            Content="&#xE928;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Padding="8,4"
                            Margin="4,2,0,2"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource ChromeText}"
                            Cursor="Hand"
                            ToolTip="文書指紋・類似検出 (Ctrl+Shift+R)" />

                    <Button x:Name="StatsButton"
                            Click="StatsButton_Click"
                            Content="&#xE908;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Padding="8,4"
                            Margin="4,2,0,2"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource ChromeText}"
                            Cursor="Hand"
                            ToolTip="フォルダ統計 (Ctrl+Shift+T)" />

                    <Button x:Name="ExportPdfButton"
                            Click="ExportPdfButton_Click"
                            Content="&#xE8A5;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Padding="8,4"
                            Margin="4,2,0,2"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource ChromeText}"
                            Cursor="Hand"
                            IsEnabled="False"
                            ToolTip="PDF にエクスポート (Ctrl+Shift+E) / 画面のズーム倍率で出力" />

                    <Button x:Name="PrintButton"
                            Click="PrintButton_Click"
                            Content="&#xE749;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Padding="8,4"
                            Margin="4,2,0,2"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource ChromeText}"
                            Cursor="Hand"
                            IsEnabled="False"
                            ToolTip="印刷 (Ctrl+P)" />

                    <Button x:Name="WorkspaceButton"
                            Click="WorkspaceButton_Click"
                            Content="&#xE7C4;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Padding="8,4"
                            Margin="4,2"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource ChromeText}"
                            Cursor="Hand"
                            ToolTip="ワークスペース (Ctrl+Shift+W)" />

                    <Button x:Name="ThemeButton"
                            Click="ThemeButton_Click"
                            Content="&#xE793;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Padding="8,4"
                            Margin="4,2,6,2"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource ChromeText}"
                            Cursor="Hand"
                            ToolTip="テーマ: 自動 (Ctrl+Shift+D)" />

                    <!-- ワークスペース一覧。専用の Window クラスは作らず Popup で完結させる
                         （モーダル入力窓の土台が無いため、既存の作りに合わせる）。 -->
                    <Popup x:Name="WorkspacePopup"
                           PlacementTarget="{Binding ElementName=WorkspaceButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           Closed="WorkspacePopup_Closed">
                        <Border Background="{DynamicResource ChromeBarBackground}"
                                BorderBrush="{DynamicResource ChromeBorder}"
                                BorderThickness="1"
                                Padding="6"
                                MinWidth="280"
                                MaxWidth="360">
                            <StackPanel>
                                <TextBlock Text="ワークスペース"
                                           Foreground="{DynamicResource ChromeSubText}"
                                           FontSize="11"
                                           Margin="4,2,4,6" />

                                <ItemsControl x:Name="WorkspaceList" MaxHeight="320">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        Click="WorkspaceOpen_Click"
                                                        Tag="{Binding Id}"
                                                        HorizontalContentAlignment="Stretch"
                                                        Padding="6,4"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Foreground="{DynamicResource ChromeText}"
                                                        Cursor="Hand"
                                                        ToolTip="{Binding Name}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding OpenMark}"
                                                                   Width="14"
                                                                   Foreground="{DynamicResource ChromeSubText}" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="220" />
                                                        <TextBlock Text="{Binding TabLabel}"
                                                                   Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource ChromeSubText}" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Grid.Column="1"
                                                        Click="WorkspaceDelete_Click"
                                                        Tag="{Binding Id}"
                                                        Content="&#xE74D;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="12"
                                                        Padding="6,4"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Foreground="{DynamicResource ChromeSubText}"
                                                        Cursor="Hand"
                                                        ToolTip="削除" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="WorkspaceEmptyText"
                                           Text="保存されたワークスペースはありません。"
                                           Foreground="{DynamicResource ChromeSubText}"
                                           FontSize="11"
                                           Margin="6,4"
                                           Visibility="Collapsed" />

                                <Separator Margin="0,6" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="WorkspaceNameBox"
                                             Grid.Column="0"
                                             MaxLength="60"
                                             Padding="4,3"
                                             Background="{DynamicResource ChromeInputBackground}"
                                             Foreground="{DynamicResource ChromeText}"
                                             BorderBrush="{DynamicResource ChromeBorder}"
                                             CaretBrush="{DynamicResource ChromeText}"
                                             VerticalContentAlignment="Center"
                                             KeyDown="WorkspaceNameBox_KeyDown"
                                             ToolTip="このウィンドウのタブ構成を名前を付けて保存します" />

                                    <Button Grid.Column="1"
                                            Click="WorkspaceSave_Click"
                                            Content="保存"
                                            Padding="10,3"
                                            Margin="6,0,0,0"
                                            Cursor="Hand" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 本体: [サイドバー][スプリッタ][コンテンツ] -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ファイルツリー / フォルダ内横断検索 サイドバー -->
            <Border x:Name="Sidebar"
                    Grid.Column="0"
                    Visibility="Collapsed"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource ChromeBorder}"
                    Background="{DynamicResource ChromeBarBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 検索ボックス（プレースホルダをオーバーレイ表示）＋意味検索トグル -->
                    <Grid Grid.Row="0" Margin="8,8,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ChromeBorder}"
                                Background="{DynamicResource ChromeInputBackground}"
                                CornerRadius="4">
                            <Grid>
                                <TextBox x:Name="SearchBox"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource ChromeText}"
                                         CaretBrush="{DynamicResource ChromeText}"
                                         Padding="6,5"
                                         VerticalContentAlignment="Center"
                                         TextChanged="SearchBox_TextChanged"
                                         PreviewKeyDown="SearchBox_PreviewKeyDown" />
                                <TextBlock x:Name="SearchPlaceholder"
                                           Text="フォルダ内を検索"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource ChromeSubText}"
                                           Padding="8,5"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 意味（セマンティック）検索トグル。ON のときは Enter で意味検索を実行する。 -->
                        <ToggleButton x:Name="SemanticToggle"
                                      Grid.Column="1"
                                      Margin="4,0,0,0"
                                      Padding="8,0"
                                      Cursor="Hand"
                                      Foreground="{DynamicResource ChromeText}"
                                      Background="{DynamicResource ChromeInputBackground}"
                                      BorderBrush="{DynamicResource ChromeBorder}"
                                      Click="SemanticToggle_Click"
                                      ToolTip="意味で検索（AI によるセマンティック検索・Enter で実行）">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleBorder"
                                            CornerRadius="4"
                                            BorderThickness="1"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Margin="{TemplateBinding Padding}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="Background"
                                                    Value="{DynamicResource ChromeAccent}" />
                                            <Setter TargetName="ToggleBorder" Property="BorderBrush"
                                                    Value="{DynamicResource ChromeAccent}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <TextBlock Text="意味" FontSize="12" />
                        </ToggleButton>
                    </Grid>

                    <!-- ツリー表示（検索が空のとき） -->
                    <Grid x:Name="TreePane" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TreeRootLabel"
                                   Grid.Row="0"
                                   Margin="10,2,10,4"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ChromeSubText}" />

                        <TreeView x:Name="FileTree"
                                  Grid.Row="1"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type local:FileTreeItem}"
                                                          ItemsSource="{Binding Children}">
                                    <Border Background="Transparent"
                                            MouseLeftButtonUp="FileTreeItem_MouseUp">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource ChromeActiveBackground}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Text="{Binding Glyph}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"
                                                       Foreground="{DynamicResource ChromeSubText}" />
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ChromeText}" />
                                        </StackPanel>
                                    </Border>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>

                        <TextBlock x:Name="TreeEmptyLabel"
                                   Grid.Row="1"
                                   Text="フォルダがありません"
                                   Visibility="Collapsed"
                                   Margin="12,10,12,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   Foreground="{DynamicResource ChromeSubText}" />
                    </Grid>

                    <!-- 検索結果表示（検索が非空のとき） -->
                    <Grid x:Name="SearchPane" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="SearchSummary"
                                   Grid.Row="0"
                                   Margin="10,2,10,4"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ChromeSubText}" />

                        <ListBox x:Name="SearchResultsList"
                                 Grid.Row="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <EventSetter Event="MouseLeftButtonUp" Handler="SearchResult_MouseUp" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="2" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,4" ToolTip="{Binding FullPath}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource ChromeText}" />
                                            <TextBlock Text="{Binding HitCountLabel}"
                                                       Margin="6,0,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ChromeAccent}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding RelativePath}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ChromeSubText}" />
                                        <ItemsControl ItemsSource="{Binding Hits}" Margin="0,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- ヒット行クリックで該当行へジャンプ（ファイル部クリックとは別動作） -->
                                                    <!-- Background=Transparent で行全体をヒットテスト可能にする -->
                                                    <TextBlock Text="{Binding Display}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Cursor="Hand"
                                                               Background="Transparent"
                                                               ToolTip="クリックで該当行へジャンプ"
                                                               MouseLeftButtonUp="SearchHit_MouseUp">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource ChromeSubText}" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource ChromeAccent}" />
                                                                        <Setter Property="TextDecorations" Value="Underline" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="SearchEmptyLabel"
                                   Grid.Row="1"
                                   Text="一致する項目がありません"
                                   Visibility="Collapsed"
                                   Margin="12,10,12,0"
                                   FontSize="12"
                                   VerticalAlignment="Top"
                                   Foreground="{DynamicResource ChromeSubText}" />
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter x:Name="SidebarSplitter"
                          Grid.Column="1"
                          Width="4"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource ChromeBorder}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <Grid Grid.Column="2">
                <!-- WebView2 を常設ホストする領域（再親子化を避けるため） -->
                <Grid x:Name="WebViewHost" />

                <!-- タブが無いときの案内 -->
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Markdown ファイルを開いてください"
                               FontSize="18"
                               Foreground="{DynamicResource ChromeTitleText}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Ctrl+O で開く / ここにファイルをドラッグ＆ドロップ"
                               FontSize="13"
                               Foreground="{DynamicResource ChromeSubText}"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Ctrl+Shift+V でクリップボードから表示"
                               FontSize="13"
                               Foreground="{DynamicResource ChromeSubText}"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
