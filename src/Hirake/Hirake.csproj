<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows.Media.Ocr（WinRT）を使うため Windows SDK 版を含むターゲットに変更。
         TargetPlatformMinVersion で 1809 以降を最小動作環境とする。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Hirake</AssemblyName>
    <RootNamespace>Hirake</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- 版の出所（ISSUE #40 設計 1-2）。
         インストーラの AppVersion と GitHub Releases のタグ（v1.1.0 など）は、
         release.yml がここと一致することを検証したうえで使う。
         ここを更新したら scripts/tag-release.ps1 でタグを打つ。

         注意: release.yml が照合するのは <Version> だけ。下の 3 つを
         上げ忘れても CI は通り、Releases は 1.1.0 なのに exe のプロパティは
         1.0.0、という状態になる。4 つまとめて動かすこと。 -->
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <Product>Hirake</Product>
    <Company>Hirake</Company>
    <Copyright>Copyright (c) Hirake contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.42.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>

  <!-- Assets は別エージェントが後から配置する。存在しなくてもビルドが通るよう
       ワイルドカードで取り込み、出力ディレクトリへコピーする。 -->
  <ItemGroup>
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
